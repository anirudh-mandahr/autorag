# OpenRouter (Llama 3.3 70B)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
LLM_MODEL=meta-llama/llama-3.3-70b-instruct

# Postgres + pgvector (matches docker-compose defaults)
DATABASE_URL=postgresql://autorag:autorag@localhost:5432/autorag

# Vector store backend: pgvector | faiss
VECTOR_BACKEND=pgvector

# Research loop budget (whichever limit is hit first)
# MAX_USD_SPEND is a hard per-session cap: the loop reserves a conservative
# max-cost estimate before each researcher or eval call and will not start
# work that cannot fit. Hosted providers that ignore max_tokens can still
# overshoot that one in-flight call; the loop then stops.
MAX_EXPERIMENTS=15
MAX_USD_SPEND=5.0
LLM_PROVIDER=openrouter
